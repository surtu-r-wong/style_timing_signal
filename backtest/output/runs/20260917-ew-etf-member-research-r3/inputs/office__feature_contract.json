  "key_rules": [
    "All date keys ISO YYYY-MM-DD",
    "Source and date unique",
    "Member IDs are four-character strings",
    "Numeric missing is empty/NaN, never zero",
    "No future inputs",
    "No compression of calendar",
    "ETF normalization in post-event share units",
    "Member selection uses prior-session OI among currently listed contracts",
    "member m5 requires 6 consecutive valid days with identical selected contract"
  ],
  "validation": {
    "etf_window": 5,
    "member_difference_lag": 5,
    "member_same_contract_sessions": 6,
    "price_return_lag": 5
