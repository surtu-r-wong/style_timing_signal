[Unit]
Description=Run style_timing_signal daily signal chain (weekdays 20:30 Asia/Shanghai)
Documentation=file:///home/elfbob/claude-code/style_timing_signal/deploy/daily_signals/README.md

[Timer]
# 20:30 = data_manager 夜间作业（WSL2 dbm-daily-wss.timer 20:00，实测约 20:02 结束）写完 15 个输入指数之后。
# 2026-09-23 起本链路不再自己取数（deploy/daily_signals/SKIP_TOPUP），输入指数由办公室统一写入、
# 并每晚重看前 5 个交易日纠错；见 data_manager/requests/2026-09-23-style-timing-signal-index-daily-takeover/。
# 此前是 18:30、由链路第一步 topup 自己经 Wind 网关取数写库。
OnCalendar=Mon-Fri 20:30 Asia/Shanghai
AccuracySec=1min
RandomizedDelaySec=2min
# 关机/休眠错过的触发在下次启动后补跑（本项目停更 35 天的直接对策之一）。
Persistent=true
Unit=style-signals-daily.service

[Install]
WantedBy=timers.target
