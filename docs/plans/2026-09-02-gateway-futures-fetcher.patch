diff -ruN orig/wind_gateway/tests/test_endpoint_futures.py new/wind_gateway/tests/test_endpoint_futures.py
--- orig/wind_gateway/tests/test_endpoint_futures.py	1970-01-01 08:00:00.000000000 +0800
+++ new/wind_gateway/tests/test_endpoint_futures.py	2026-09-02 18:47:10.359099996 +0800
@@ -0,0 +1,82 @@
+from datetime import date
+import pytest
+from fastapi.testclient import TestClient
+from wind_gateway.main import create_app
+from wind_gateway.quota import DailyQuota
+
+FUTURES_FIELDS = "open,high,low,close,volume,oi,amt,settle"
+
+
+@pytest.fixture
+def app_and_client(fake_wind, tmp_path):
+    cfg = {
+        "server": {"port": 8080, "auth_token": "t"},
+        "quota": {"max_per_day": 1000, "persist_path": str(tmp_path / "q.json")},
+        "fetchers": {
+            "price": {"wsd_fields": "open,high,low,close,volume,amt,turn,adjfactor", "wsd_options": ""},
+            "futures": {"wsd_fields": FUTURES_FIELDS, "wsd_options": ""},
+        },
+    }
+    app = create_app(cfg)
+    app.state.wind = fake_wind
+    app.state.quota = DailyQuota(path=tmp_path / "q.json", max_per_day=1000)
+    return app, TestClient(app)
+
+
+def test_fetch_futures_ok_and_carries_oi_settle(app_and_client, fake_wind):
+    _app, client = app_and_client
+    fields = FUTURES_FIELDS.split(",")
+    fake_wind.queue_wsd(
+        codes=["IC2609.CFE"], fields=fields,
+        times=[date(2026, 8, 25)],
+        data=[[6000.0], [6050.0], [5980.0], [6020.0], [12345], [98765], [1.5e9], [6018.6]],
+    )
+    r = client.get(
+        "/fetch/futures",
+        params={"codes": "IC2609.CFE", "start": "2026-08-25", "end": "2026-08-25"},
+        headers={"Authorization": "Bearer t"},
+    )
+    assert r.status_code == 200
+    j = r.json()
+    assert j["columns"] == ["ts_code", "trade_date"] + fields
+    assert j["rows"][0][j["columns"].index("oi")] == 98765
+    assert j["rows"][0][j["columns"].index("settle")] == 6018.6
+    # YAML wiring: the futures fetcher, not price, decided the field list
+    assert fake_wind.wsd_calls[0]["fields"] == FUTURES_FIELDS
+    assert fake_wind.wsd_calls[0]["codes"] == "IC2609.CFE"
+
+
+def test_fetch_futures_does_not_touch_price_fetcher(app_and_client, fake_wind):
+    """price stays stock-calibre: adding futures must not widen /fetch/price."""
+    _app, client = app_and_client
+    fake_wind.queue_wsd(
+        codes=["600519.SH"], fields="open,high,low,close,volume,amt,turn,adjfactor".split(","),
+        times=[date(2026, 8, 25)], data=[[1], [1], [1], [1], [1], [1], [1], [1]],
+    )
+    r = client.get(
+        "/fetch/price",
+        params={"codes": "600519.SH", "start": "2026-08-25", "end": "2026-08-25"},
+        headers={"Authorization": "Bearer t"},
+    )
+    assert r.status_code == 200
+    assert "oi" not in r.json()["columns"]
+    assert fake_wind.wsd_calls[0]["fields"] == "open,high,low,close,volume,amt,turn,adjfactor"
+
+
+def test_fetch_futures_fetcher_missing_in_config(tmp_path, fake_wind):
+    cfg = {
+        "server": {"port": 8080, "auth_token": "t"},
+        "quota": {"max_per_day": 100, "persist_path": str(tmp_path / "q.json")},
+        "fetchers": {"price": {"wsd_fields": "open,close", "wsd_options": ""}},
+    }
+    app = create_app(cfg)
+    app.state.wind = fake_wind
+    app.state.quota = DailyQuota(path=tmp_path / "q.json", max_per_day=100)
+    c = TestClient(app)
+    r = c.get("/fetch/futures",
+              params={"codes": "IC2609.CFE", "start": "2026-08-25", "end": "2026-08-25"},
+              headers={"Authorization": "Bearer t"})
+    assert r.status_code == 500
+    body = r.json()
+    assert body["error"] == "fetcher_not_configured"
+    assert "futures" in body["detail"]
